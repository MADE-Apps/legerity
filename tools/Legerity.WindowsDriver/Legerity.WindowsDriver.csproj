<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>Legerity Windows Driver</Product>
    <Description>A W3C WebDriver compliant server for Windows UI Automation testing, replacing WinAppDriver</Description>
    <RootNamespace>Legerity.WindowsDriver</RootNamespace>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Legerity.WindowsDriver</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>WebDriver WinAppDriver Windows UIA UIAutomation Appium Selenium</PackageTags>

    <!-- Pack the publish output into tools/ so consumers get the exe -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <!-- Pack build output into tools/ inside the NuGet package -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackToolsFolder</TargetsForTfmSpecificContentInPackage>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <Target Name="_PackToolsFolder">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json;$(OutputPath)publish\**">
        <PackagePath>tools/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>